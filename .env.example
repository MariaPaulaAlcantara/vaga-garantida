DATABASE_URL="postgresql://vaga:vaga@localhost:5432/vaga_garantida?schema=public"
# Neon (production): append sslmode=require, e.g.
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
OTP_MOCK_CODE="123456"
# Twilio SMS (produção / piloto) — se preenchido, envia OTP por SMS
# TWILIO_ACCOUNT_SID="ACxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxx"
# TWILIO_PHONE_NUMBER="+15551234567"
# Email (MailerSend) — se preenchido, envia notificações por email; senão, log [MOCK EMAIL]
# MAILERSEND_API_TOKEN="mlsn.xxxxxxxx"
# EMAIL_FROM="Vaga Garantida <noreply@seudominio.com>"
# URL pública do frontend (links nos emails). Deve ser a URL do app Next.js, não a landing page.
WEB_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
API_PORT=3001
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Produção (Railway + domínios customizados) — configure no painel de cada serviço:
# Serviço API:
#   CORS_ORIGIN="https://app.vagagarantida.dev.br"
#   WEB_APP_URL="https://app.vagagarantida.dev.br"
#   APP_URL="https://app.vagagarantida.dev.br"
# Serviço Web (NEXT_PUBLIC_* é embutido no build — altere e faça redeploy):
#   NEXT_PUBLIC_API_URL="https://api.vagagarantida.dev.br"
