{
  "name": "vaga-garantida",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @vaga-garantida/api\" \"npm run dev -w @vaga-garantida/web\"",
    "dev:api": "npm run dev -w @vaga-garantida/api",
    "dev:web": "npm run dev -w @vaga-garantida/web",
    "build": "npm run build -w @vaga-garantida/database && npm run build -w @vaga-garantida/api && npm run build -w @vaga-garantida/web",
    "build:api": "npm run build -w @vaga-garantida/database && npm run build -w @vaga-garantida/api",
    "start:api": "node apps/api/dist/main.js",
    "db:generate": "npm run generate -w @vaga-garantida/database",
    "db:migrate": "npm run migrate -w @vaga-garantida/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @vaga-garantida/database",
    "db:seed": "npm run seed -w @vaga-garantida/database",
    "start:api:prod": "npm run db:migrate:deploy && node apps/api/dist/main.js",
    "db:studio": "npm run studio -w @vaga-garantida/database"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "postcss": "8.5.15"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "next": {
      "postcss": "$postcss"
    },
    "shell-quote": "1.8.4"
  }
}
